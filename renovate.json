{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "includePaths": [
    "apps/docs/**"
  ],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "matchFileNames": [
        "apps/docs/package.json"
      ],
      "groupName": "docs site (Astro + Starlight)"
    }
  ]
}
