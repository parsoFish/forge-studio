# No trailing slash: also matches a node_modules SYMLINK (agent worktrees
# symlink the main checkout's node_modules; the slash form let `git add -A`
# commit the symlink, and checking that out clobbered the real directory).
node_modules
dist/

# Ephemeral diagnostic scripts (e.g., one-off probes / browser drives).
# Convention: prefix with .tmp- in scripts/ for things that are useful
# locally but shouldn't churn the tree.
scripts/.tmp-*

# forge-ui (Next.js workspace) build artefacts
forge-ui/.next/
forge-ui/out/
forge-ui/tsconfig.tsbuildinfo
forge-ui/next-env.d.ts
# demos/ PNG frame galleries + index.html + the short building/generating CLIPS
# (demos/e2e/clips/*.webm, each <400K — the autoplay-loop "GIFs") are version-tracked.
# The big full-run VIDEOS are NOT — regenerable + too large for git (a verify
# cycle.webm hit 110MB, past GitHub's 100MB cap). Regenerate locally via
# `npm run ui:journey` / `verify:cycle`.
demos/e2e/video/*.webm
demos/verify/**/*.webm

# Runtime state — not source. Ignore contents but keep .gitkeep so structure
# is preserved in git.
_logs/*
!_logs/.gitkeep
!_logs/README.md
_queue/pending/*
!_queue/pending/.gitkeep
_queue/in-flight/*
!_queue/in-flight/.gitkeep
_queue/ready-for-review/*
!_queue/ready-for-review/.gitkeep
_queue/done/*
!_queue/done/.gitkeep
_queue/failed/*
!_queue/failed/.gitkeep

# scripts/journeys/home.mjs's own scratch KB fixture (home-attention beat,
# forge-2am) — proves the Home attention strip's real per-KB lint-flag row
# against a REAL brain-lint finding, never a hand-poked count. Swept by the
# journey's own cleanHomeFixture() every run; never committed (unlike the
# real brain/projects/<id> dirs above it, which ARE forge-owned central
# content per ADR 035).
brain/projects/home-fixture-lint-kb/
# scripts/journeys/stand-up-create.mjs's own scratch KB fixture (A1.3,
# W7-FIX-B-UI) — same directly-verified lint-flag shape as the home fixture
# above, on its own slug so the two journeys never collide. Swept by the
# beat's own cleanSuLintKb() (leading sweep + finally); never committed.
brain/projects/sucreate-fixture-lint-kb/

# R3-04 connections install root — installed npm packages for curated
# tools/MCPs (probeConnection/installConnection, orchestrator/studio/
# connection-probe.ts), created on demand. Not source, never committed.
_connections/

# Managed projects are auto-discovered, not committed to forge
projects/*
!projects/README.md
!projects/.gitkeep
# Exception: mdtoc is forge's checked-in OOTB reference project (WS-B5). Track
# the directory so the contract's worked example ships with forge; the project's
# own projects/mdtoc/.gitignore still excludes its build outputs + scratch.
!projects/mdtoc/

# Worktrees the scheduler creates
_worktrees/

# SEC-05 q80: skill-package install staging root (<forgeRoot>/_skill-staging).
# The install route stages uploaded entries here (per-entry containment
# re-checked) before installSkillPackage copies them into skills/<id>/.
# Runtime, never source.
_skill-staging/

# R4-21 phase 2 / ADR-043: the generic interactive-runner's finalize landing
# root (<forgeRoot>/_interactive-library). `copyStagingToLibrary`
# (orchestrator/interactive-finalizers.ts) lands a session's drafted package
# here before cli/bridge-studio-authoring.ts installs it into skills/<id>/ or
# studio/hooks/<id>/. Runtime, never source.
_interactive-library/

# Unifier scratchpad + DEMO bundle directories — these belong to a
# worktree, but occasionally leak to the forge root when a worktree's
# fast-forward into main carries gitignored-elsewhere paths. Pin them
# at the root so the leak doesn't recur.
/.forge/
/demo/

# Review/audit output — runtime artefact, not source
_review/

# Forge's own runtime config (per-machine)
forge.config.json

# Secrets — never commit. zep.env holds the Zep Cloud API key (KB backend);
# the catch-all guards any other local credential files.
zep.env
secrets.env
*.env
!*.env.example

# Editor / OS noise
.DS_Store
.vscode/
.idea/
# Local Claude Code state (settings, transcripts) is per-machine noise — but
# .claude/commands/ holds the operator-facing slash-command SOURCE (the three
# human-interaction moments; Phase 7 / US-3.1) and IS committed.
# .claude/skills/journey-sync/ is the UI-journey maintenance contract (the demo
# harness sync rules) and IS committed — other .claude/skills stay local.
.claude/*
!.claude/commands/
!.claude/skills/
.claude/skills/*
!.claude/skills/journey-sync/
*.swp
*.swo
*~

# Obsidian vault config (per-user)
brain/.obsidian/

# Logs from local runs
*.log
npm-debug.log*

# Local SQLite scratch (e.g. headroom memory) — never source
*.db

# graphify output — the graphify tooling was removed, but an external/global
# graphify hook may still regenerate this at the repo root. Output-ignore only.
graphify-out/

# One-shot audit/investigation reports (project-scoped-review output) — working
# artifacts, not source; durable lessons are extracted to the brain + ADRs.
# Ignore the CONTENTS (not the dir) so a specific durable report can be
# re-included below (git can't re-include under a dir-level exclude).
docs/investigations/*
# Exception: durable roadmap-gate research spikes ARE tracked (their go/no-go
# recommendation is a dependency for a roadmap decision, not scratch).
!docs/investigations/R2-03-fanout-merge-resolution-spike.md

# local code-graph tool cache (tokensave MCP)
.tokensave/

# End-state mockup v2 journey videos (large; regenerated via the capture script noted in
# mockups/studio-endstate-v2/README.md — sources are tracked, renders are not)
mockups/studio-endstate-v2/journeys/

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key
.beads/proxieddb/

# wave-5/wave-6 session-local state: tiered-orchestration AND scripts/perf-snapshot.mjs's _wave6/perf/ output.
_wave5/
_wave6/
_wave7/
_wave8/
# scripts/ui-walkthrough default output
_walkthrough/
.beads/

# forge 1.0 campaign state (tiered-orchestration)
_1.0
