# No trailing slash: also matches a node_modules SYMLINK (agent worktrees
# symlink the main checkout's node_modules; the slash form let `git add -A`
# commit the symlink, and checking that out clobbered the real directory).
node_modules
dist/

# Ephemeral diagnostic scripts (e.g., one-off probes / browser drives).
# Convention: prefix with .tmp- in scripts/ for things that are useful
# locally but shouldn't churn the tree.
scripts/.tmp-*

# apps/studio (the Next.js workspace, formerly forge-ui) build artefacts
apps/studio/.next/
apps/studio/out/
apps/studio/tsconfig.tsbuildinfo
apps/studio/next-env.d.ts
# demos/verify PNG frame galleries + index.html + summary.json are version-tracked.
# The big full-run VIDEOS are NOT — regenerable + too large for git (a verify
# cycle.webm hit 110MB, past GitHub's 100MB cap). Regenerate locally via
# `npm run verify:cycle`. Story clips are ignored too, under their own rule and
# their own reasoning, near the bottom of this file.
demos/verify/**/*.webm

# Runtime state — not source. Ignore contents but keep .gitkeep so structure
# is preserved in git.
_logs/*
!_logs/.gitkeep
!_logs/README.md
# A workspace-scoped run (`npm test --workspace=packages/<x>`) resolves a
# cwd-relative `_logs` root under the PACKAGE, not the repo root (bead
# forge-8vfn.5.53), and the root rows above are anchored to this directory —
# so nested runtime state needs its own rows. `packages/**` and `apps/**` are
# exactly the npm workspace globs; a scanner-style hand-list of one of them is
# the next blind spot (COMMON §15.82).
packages/**/_logs/
apps/**/_logs/
_queue/pending/*
!_queue/pending/.gitkeep
_queue/in-flight/*
!_queue/in-flight/.gitkeep
_queue/ready-for-review/*
!_queue/ready-for-review/.gitkeep
# R4-11-F1: `merged` is a transient pass-through queue state (packages/flows/
# queue.ts) between a confirmed remote merge and the same-sweep `done/`
# promotion — a real manifest can sit here (T3 M7-A, 2026-09-25: a reflector
# killed before firing the promotion left one behind), so it needs the SAME
# ignore-with-.gitkeep-exception treatment as every other queue state dir.
_queue/merged/*
!_queue/merged/.gitkeep
_queue/done/*
!_queue/done/.gitkeep
_queue/failed/*
!_queue/failed/.gitkeep

# Scratch KB fixture slugs from the retired journey harness (deleted in
# 7.6.131). The rules stay: an old checkout that still has these dirs on disk
# must not start committing them, and the slugs are cheap to keep ignored.
brain/projects/home-fixture-lint-kb/
brain/projects/sucreate-fixture-lint-kb/

# R3-04 connections install root — installed npm packages for curated
# tools/MCPs (probeConnection/installConnection, orchestrator/studio/
# connection-probe.ts), created on demand. Not source, never committed.
_connections/

# Managed projects are auto-discovered, not committed to forge
projects/*
!projects/README.md
!projects/.gitkeep
# Exception: mdtoc is forge's checked-in OOTB reference project (WS-B5). Track
# the directory so the contract's worked example ships with forge; the project's
# own projects/mdtoc/.gitignore still excludes its build outputs + scratch.
!projects/mdtoc/

# Worktrees the scheduler creates
_worktrees/

# SEC-05 q80: skill-package install staging root (<forgeRoot>/_skill-staging).
# The install route stages uploaded entries here (per-entry containment
# re-checked) before installSkillPackage copies them into skills/<id>/.
# Runtime, never source.
_skill-staging/

# forge-7zp: template-content validation staging root (<forgeRoot>/_template-staging).
# invalidTemplateContentReason (packages/library/bridge-studio-templates.ts) stages
# candidate template bytes here before loadArtifactTemplate/loadDemoElement
# validates them, and rm's the dir in a `finally`. Runtime, never source.
_template-staging/

# R4-21 phase 2 / ADR-043: the generic interactive-runner's finalize landing
# root (<forgeRoot>/_interactive-library). `copyStagingToLibrary`
# (orchestrator/interactive-finalizers.ts) lands a session's drafted package
# here before cli/bridge-studio-authoring.ts installs it into skills/<id>/ or
# studio/hooks/<id>/. Runtime, never source.
_interactive-library/

# Unifier scratchpad + DEMO bundle directories — these belong to a
# worktree, but occasionally leak to the forge root when a worktree's
# fast-forward into main carries gitignored-elsewhere paths. Pin them
# at the root so the leak doesn't recur.
/.forge/
/demo/

# Review/audit output — runtime artefact, not source
_review/

# Forge's own runtime config (per-machine)
forge.config.json

# Secrets — never commit. zep.env holds the Zep Cloud API key (KB backend);
# the catch-all guards any other local credential files.
zep.env
secrets.env
*.env
!*.env.example

# Editor / OS noise
.DS_Store
.vscode/
.idea/
# Local Claude Code state (settings, transcripts) is per-machine noise — but
# .claude/commands/ holds the operator-facing slash-command SOURCE (the three
# human-interaction moments; Phase 7 / US-3.1) and IS committed.
# .claude/skills/journey-sync/ is the UI-journey maintenance contract (the demo
# harness sync rules) and IS committed; .claude/skills/tiered-orchestration/ is the
# campaign mechanism (lanes.sh, the lane protocol + hook, the stall watcher) and IS
# committed — and so are the two skills tiered-orchestration's "See also" sends its
# readers to. Those two were ignored until 2026-09-04, so no lane worktree since M0
# had them: a brief citing `immutable-gates` named a skill the lane could not open.
# .claude/skills/security-review/ is the repo's OWN change review and IS committed
# (`forge-8vfn.7.6.69`, T1 ruling 926): the bundled skill of that name shells
# `git diff origin/HEAD...` and this repo's remote is `parsoFish`, so it aborted for
# every lane — and the literal is compiled into the Claude Code binary, so it was
# never ours to fix. A review that lived in one worktree would be the same defect
# as the `immutable-gates` gap above: a rule everyone is told to follow and nobody
# can open. Other .claude/skills stay local.
.claude/*
!.claude/commands/
!.claude/skills/
.claude/skills/*
!.claude/skills/journey-sync/
!.claude/skills/tiered-orchestration/
!.claude/skills/immutable-gates/
!.claude/skills/adversarial-containment-review/
!.claude/skills/security-review/
*.swp
*.swo
*~

# Obsidian vault config (per-user)
brain/.obsidian/

# Logs from local runs
*.log
npm-debug.log*

# Local SQLite scratch (e.g. headroom memory) — never source
*.db

# graphify output — the graphify tooling was removed, but an external/global
# graphify hook may still regenerate this at the repo root. Output-ignore only.
graphify-out/

# One-shot audit/investigation reports (project-scoped-review output) — working
# artifacts, not source; durable lessons are extracted to the brain + ADRs.
# Ignore the CONTENTS (not the dir) so a specific durable report can be
# re-included below (git can't re-include under a dir-level exclude).
docs/investigations/*
# Exception: durable roadmap-gate research spikes ARE tracked (their go/no-go
# recommendation is a dependency for a roadmap decision, not scratch).
!docs/investigations/R2-03-fanout-merge-resolution-spike.md

# local code-graph tool cache (tokensave MCP)
.tokensave/

# End-state mockup v2 journey videos (large; regenerated via the capture script noted in
# mockups/studio-endstate-v2/README.md — sources are tracked, renders are not)
mockups/studio-endstate-v2/journeys/

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key
.beads/proxieddb/

# wave-5/wave-6 session-local state: tiered-orchestration AND scripts/perf-snapshot.mjs's _wave6/perf/ output.
_wave5/
_wave6/
_wave7/
_wave8/
# Output dir of the retired ui-walkthrough crawl (deleted in 7.6.131); kept
# ignored so an old checkout does not start committing a stale _walkthrough/.
_walkthrough/
.beads/

# forge 1.0 campaign state (tiered-orchestration)
_1.0

# Story clips: the .webm encode is not byte-deterministic, so every committed re-run adds a
# permanent blob (46 MB / 150 files after one milestone). Frames, story.json and the generated
# doc ARE deterministic and stay tracked — operator ruling 2026-08-30, amends 1.0.md §3.
demos/stories/**/*.webm
