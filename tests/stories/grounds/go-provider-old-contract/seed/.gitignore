.env
# Local secrets for the live acceptance/test harness — NEVER commit
secrets.env
#direnv files
.envrc
bin/

# forge orchestration scratch (preflight C2). The .forge/ runtime dir
# (work-items/, verdicts, etc.) must never land in a PR; the two committed
# config files (.forge/project.json, .forge/quality_gate_cmd) are
# force-tracked via `git add -f` so they survive this ignore.
.forge/
AGENT.md
PROMPT.md
fix_plan.md

terraform-provider-azure-devops
# Compiled provider binary (renamed from the upstream name above). `make build`
# emits this at the repo root; without ignoring it, forge's `git add -A` commits
# a ~35 MB binary into every cycle's PR.
terraform-provider-betterado
terraform.log
crash.log

#  Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# .tfvars files
*.tfvars

# ignore tf files in the root directory
/*.tf

# unwanted binary files (compiled test binaries)
**/debug.test
*.test
dist


#GoLand Editor configuration
.idea
.fleet

.DS_Store

*.exe

# Rebuildable knowledge graph (regenerated by graphify). Never commit the AST
# cache. Brain 3 + durable history are forge-owned & central (ADR 035); only the
# per-cycle in-PR demo lands in-repo under forge/history/<id>/demo.
/graphify-out/

# forge session scratch (architect / demo-builder / instructions-creator — not part of the project)
_architect/
_demo/
_instructions/
