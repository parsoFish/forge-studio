# --- Hermetic commit capture (forge contract C2 + ARTIFACTS) ---

# Build outputs (tsc emits here) — never source.
dist/
*.tsbuildinfo
coverage/

# Dependencies.
node_modules/

# Forge per-cycle scratch (regenerated each cycle; must never enter a PR).
# No trailing slash on work-items so the bare path is git-ignored too — the
# preflight C2 git-truth check queries `.forge/work-items` (slash stripped).
# `.forge/project.json` + `.forge/skills/` stay tracked (they aren't matched here).
.forge/work-items
AGENT.md
PROMPT.md
fix_plan.md

# Runtime / session scratch that forge writes into the worktree.
# Kept in step with forge's SCRATCH_EXCLUDES (orchestrator/project-repo-tx.ts):
# these are the session-kind dirs forge writes into the project worktree, and
# forge commits with `git add -A`, so they must be ignored, not merely untracked.
# The unanchored `demo/` that used to sit here also matched
# `forge/history/<initiative-id>/demo/` — the demo evidence demoProcess requires
# in the PR — so it silently dropped every new initiative's evidence. Removed.
_architect/
_demo/
_instructions/
_preflight-fix/
_project-brain/

# Demo-builder per-session archive. The DURABLE half — `.forge/demo/demo.lock.json`
# and `.forge/demo/DEMO.html` — is tracked, because `cli/contract-stages.ts` reads
# the lock as the demo contract stage's source of truth. The per-session history
# under it is regenerable output, ignored like `.forge/work-items`.
.forge/demo/history/

# Local credentials (this project needs none, but guard against any).
secrets.env
*.env
!*.env.example

# Editor / OS noise.
.DS_Store
*.swp
.forge/work-items/
.forge/.create-complete
.forge/live-evidence/
.forge/preflight.json
